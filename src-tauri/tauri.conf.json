{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "illegacy",
  "version": "0.4.0",
  "identifier": "com.fishman.illegacy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "illegacy",
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis"
    ],
    "resources": [
      "docker/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Russian", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["docker.io"]
      },
      "rpm": {
        "depends": ["docker"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
